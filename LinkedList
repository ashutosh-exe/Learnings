Address and pointer use in C for the revision
//*p -> for the value
//& -> for the address

Code ->
#include <stdio.h>
int main()
{
int a = 10;
int *p;
p = &a;        //we have stored address of a in the p but we can also access the value of a in p just by using *p
printf("Value of a = %d",a);  
printf("\nAddress of a =%p",&a);

printf("\nValue of p = %d",*p);  
printf("\nAddress of a =%p",p);

printf("\nAddress of p = %p",&p);

return 0;
}

