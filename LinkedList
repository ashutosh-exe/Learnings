For struct
#include <stdio.h>
#include <string.h>
struct Student
{
int id;
char name[30];
int age;
};
int main()
{
struct Student s1 = {1002,"Ashutosh",26};
struct Student s;
struct Student s3;
s.id=1001;
strcpy(s.name,"Amit");
s.age=25;
printf("\nId=%d",s.id);
printf("Name=%s",s.name);
printf("Age=%d\n",s.age);

printf("\nId=%d",s1.id);
printf("Name=%s",s1.name);
printf("Age=%d\n",s1.age);

printf("Enter Id :");
scanf("%d",&s3.id);
fflush(stdin);
printf("Enter name:");
scanf("%s",s3.name);
fflush(stdin);
printf("Enter age");
scanf("%d",&s3.age);

printf("\nId=%d",s3.id);
printf("Name=%s",s3.name);
printf("Age=%d\n",s3.age);

return 0;
}

